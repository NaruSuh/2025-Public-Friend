# ============================================
# naPO 환경변수 설정
# ============================================
# 이 파일을 .env로 복사하고 값을 설정하세요.
# cp .env.example .env

# ============================================
# [필수] 데이터베이스 설정
# ============================================
# PostgreSQL 연결 URL (Supabase 또는 로컬)
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/napo_dev"
DATABASE_PROVIDER="local"   # "supabase" 또는 "local"

# ============================================
# [필수] AI API 키 (자연어 쿼리용)
# ============================================
# Gemini API 키 (권장) - https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_CHAT_MODEL="models/gemini-2.5-flash"
GEMINI_EMBED_MODEL="text-embedding-004"
GEMINI_API_VERSION="v1"          # v1beta or v1 (use v1 for embeddings)
RAG_EMBED_PROVIDER="gemini"       # gemini | local
RAG_EMBED_MODEL_LOCAL="Xenova/all-MiniLM-L6-v2"

# OpenAI API 키 (대체) - 현재 사용 안함
# OPENAI_API_KEY="sk-..."

# ============================================
# [필수] 공공데이터 API 키
# ============================================
# 공공데이터포털 - https://www.data.go.kr/
# 선거공약정보, 당선인정보, 정당정책 API에 사용
PUBLIC_DATA_API_KEY="your_public_data_api_key_here"

# ============================================
# [선택] 추가 API 키
# ============================================
# R-ONE 부동산 통계 API
# RONE_API_KEY="your_rone_api_key"

# YouTube Data API (향후 사용)
# YOUTUBE_API_KEY="your_youtube_api_key"

# ============================================
# [선택] OCR 서비스
# ============================================
# Naver Clova OCR
# CLOVA_OCR_API_URL="https://..."
# CLOVA_OCR_SECRET_KEY="..."

# Google Cloud Vision
# GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"

# ============================================
# [필수] 서버 설정
# ============================================
NODE_ENV="development"      # development | production | test
PORT=3001                   # 백엔드 포트
FRONTEND_URL="http://localhost:5173"  # 프론트엔드 URL (CORS용)

# ============================================
# [필수] 인증 설정
# ============================================
# JWT 서명 키 (충분히 긴 랜덤 문자열 사용)
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars"

# ============================================
# [선택] 기능 플래그
# ============================================
ENABLE_NL_QUERY=true        # 자연어 쿼리 기능
ENABLE_OCR_PARSING=true     # OCR 파싱 기능
ENABLE_CRAWLING=true        # 웹 크롤링 기능

# ============================================
# [선택] RAG 설정 (SQLite)
# ============================================
RAG_DB_PATH="/home/naru/dev/naID/naPO/apps/backend/data/rag.sqlite"
RAG_SOURCE_ROOT="/home/naru/dev/naID/naPO_DB"
RAG_TOP_K=5
RAG_FTS_LIMIT=60
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_DOCS=
RAG_MAX_FILE_MB=50
RAG_MAX_CHUNKS_PER_DOC=200
RAG_CONTEXT_MAX=6000
RAG_INCLUDE_PATHS=
RAG_EXCLUDE_PATHS=
RAG_SKIP_PDF=false

# ============================================
# [선택] 모니터링
# ============================================
# Sentry DSN (에러 추적)
# SENTRY_DSN="https://..."

# ============================================
# 빠른 시작 체크리스트
# ============================================
# 1. DATABASE_URL 설정 (PostgreSQL 필요)
# 2. GEMINI_API_KEY 설정 (자연어 쿼리에 필수)
# 3. PUBLIC_DATA_API_KEY 설정 (공공 API 호출에 필수)
# 4. JWT_SECRET 변경 (프로덕션에서 필수)
# 5. pnpm db:push && pnpm db:seed 실행
